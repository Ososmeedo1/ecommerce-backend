# Copy this file to `.env` and replace the placeholders.
# Never commit a real `.env` or real credentials.

# --- Application ---
MONGO_URI=mongodb://127.0.0.1:27017/ecommerce
PORT=3000
SALT_ROUNDS=10
BEARER_KEY=replace-with-your-token-prefix
CONFIRMATION_SECRET=replace-with-a-long-random-secret
TIMEZONE=Africa/Cairo

# --- ImageKit (product images) ---
IMAGE_KIT_PUBLIC_KEY=replace-me
IMAGE_KIT_PRIVATE_KEY=replace-me
IMAGE_KIT_URL_ENDPOINT=https://ik.imagekit.io/your-endpoint
UPLOADS_FOLDER=uploads

# --- Password-reset email (nodemailer) ---
# Gmail: enable 2-Step Verification and create an App Password. A normal
# Gmail account password will not work.
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-google-app-password
EMAIL_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Masar
# EMAIL_REPLY_TO=support@example.com

# For a non-Gmail SMTP provider (or a local mail catcher), set the host and
# port instead. When EMAIL_HOST is set, EMAIL_SERVICE is ignored.
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false

# Backward-compatible aliases from the reference project. They are used only
# when EMAIL_USER / EMAIL_PASS are not set.
# USER_SEND_EMAIL_SERVICE=your-email@gmail.com
# PASSWORD_SEND_EMAIL_SERVICE=your-google-app-password
